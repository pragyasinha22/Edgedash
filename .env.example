# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# Required for Postgres database (deployment). Leave blank for local SQLite.
DATABASE_URL=

# Required for Apify source (week 2). Leave blank to skip that source.
APIFY_TOKEN=

# Required when llm_provider is "gemini" in config.yaml.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
